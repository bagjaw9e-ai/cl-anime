 "beats": [
  {
   "id": 1,
   "text": "Apa yang terjadi pada otak",
   "f0": 0,
   "imp": true
  },
  {
   "id": 2,
   "text": "kalau lo enggak coli",
   "f0": 41,
   "imp": false
  },
  {
   "id": 3,
   "text": "selama 30 hari?",
   "f0": 73,
   "imp": true
  },
  {
   "id": 4,
   "text": "Tiga hari pertama",
   "f0": 109,
   "imp": false
  },
  {
   "id": 5,
   "text": "adalah fase yang paling berat.",
   "f0": 133,
   "imp": true
  },
  {
   "id": 6,
   "text": "Bukan karena tubuh lo butuh,",
   "f0": 201,
   "imp": false
  },
  {
   "id": 7,
   "text": "tapi karena otak lo udah hafal polanya:",
   "f0": 244,
   "imp": false
  },
  {
   "id": 8,
   "text": "bosen,",
   "f0": 311,
   "imp": false
  },
  {
   "id": 9,
   "text": "sendirian,",
   "f0": 334,
   "imp": false
  },
  {
   "id": 10,
   "text": "pegang HP",
   "f0": 358,
   "imp": false
  },
  {
   "id": 11,
   "text": "langsung balik buka bokep",
   "f0": 374,
   "imp": false
  },
  {
   "id": 12,
   "text": "dan onani.",
   "f0": 412,
   "imp": false
  },
  {
   "id": 13,
   "text": "Fase ini, lo akan merasakan gejala withdrawal",
   "f0": 437,
   "imp": true
  },
  {
   "id": 14,
   "text": "atau sakau.",
   "f0": 505,
   "imp": false
  },
  {
   "id": 15,
   "text": "Sekitar hari ketujuh,",
   "f0": 539,
   "imp": false
  },
  {
   "id": 16,
   "text": "satu studi dari Journal of Zhejiang University-SCIENCE",
   "f0": 578,
   "imp": true
  },
  {
   "id": 17,
   "text": "bilang kalau kadar testosteron pria",
   "f0": 662,
   "imp": false
  },
  {
   "id": 18,
   "text": "naik sampai sekitar 145% dari normal,",
   "f0": 721,
   "imp": true
  },
  {
   "id": 19,
   "text": "terus balik lagi ke level biasa.",
   "f0": 824,
   "imp": false
  },
  {
   "id": 20,
   "text": "Jadi bukan jadi Superman,",
   "f0": 867,
   "imp": false
  },
  {
   "id": 21,
   "text": "cuma tanda tubuh lo lagi menyesuaikan.",
   "f0": 926,
   "imp": false
  },
  {
   "id": 22,
   "text": "Masuk ke fase yang datar, yaitu di minggu kedua.",
   "f0": 988,
   "imp": false
  },
  {
   "id": 23,
   "text": "Banyak yang ngerasa lesu,",
   "f0": 1078,
   "imp": false
  },
  {
   "id": 24,
   "text": "libido drop,",
   "f0": 1120,
   "imp": false
  },
  {
   "id": 25,
   "text": "mood datar.",
   "f0": 1148,
   "imp": false
  },
  {
   "id": 26,
   "text": "Fase ini biasa disebut flatline.",
   "f0": 1177,
   "imp": true
  },
  {
   "id": 27,
   "text": "Otak bagian amigdala",
   "f0": 1245,
   "imp": false
  },
  {
   "id": 28,
   "text": "sedang menyesuaikan kadar dopamin ke level yang normal.",
   "f0": 1277,
   "imp": false
  },
  {
   "id": 29,
   "text": "Jadi wajar kalau lo ngerasa gelisah,",
   "f0": 1367,
   "imp": false
  },
  {
   "id": 30,
   "text": "karena hormon kebahagiaan biasanya naik dari PMO,",
   "f0": 1439,
   "imp": false
  },
  {
   "id": 31,
   "text": "dan sekarang otak lo sedang didetoks dari bokep dan coli.",
   "f0": 1528,
   "imp": true
  },
  {
   "id": 32,
   "text": "Masuk ke minggu ketiga dan minggu terakhir.",
   "f0": 1634,
   "imp": true
  },
  {
   "id": 33,
   "text": "Setiap kali lo berhasil nahan dorongan PMO,",
   "f0": 1694,
   "imp": false
  },
  {
   "id": 34,
   "text": "lo lagi melatih otak buat memilih.",
   "f0": 1778,
   "imp": false
  },
  {
   "id": 35,
   "text": "Di fase ini banyak orang mulai merasa punya waktu lebih banyak,",
   "f0": 1840,
   "imp": false
  },
  {
   "id": 36,
   "text": "fokus mereka juga jadi lebih panjang.",
   "f0": 1939,
   "imp": false
  },
  {
   "id": 37,
   "text": "Yang paling penting, lo bukan lagi orang yang dikendalikan sama hawa nafsu.",
   "f0": 2002,
   "imp": true
  },
  {
   "id": 38,
   "text": "Lo bisa kontrol otak tengah",
   "f0": 2121,
   "imp": false
  },
  {
   "id": 39,
   "text": "dan otak bagian PFC kembali lebih dominan.",
   "f0": 2163,
   "imp": true
  },
  {
   "id": 40,
   "text": "Tapi ingat, rata-rata kebiasaan baru butuh sekitar 66 hari buat nempel.",
   "f0": 2242,
   "imp": true
  },
  {
   "id": 41,
   "text": "Jadi 30 hari itu bukan garis finish,",
   "f0": 2382,
   "imp": false
  },
  {
   "id": 42,
   "text": "itu baru awal lo pegang kendali.",
   "f0": 2454,
   "imp": false
  },
  {
   "id": 43,
   "text": "Lo juga akan mengalami mimpi basah dan itu adalah hal normal.",
   "f0": 2498,
   "imp": false
  },
  {
   "id": 44,
   "text": "Mimpi basah merupakan cara sperma keluar secara organik,",
   "f0": 2618,
   "imp": false
  },
  {
   "id": 45,
   "text": "bukan artifisial atau paksaan seperti dari onani.",
   "f0": 2708,
   "imp": false
  },
  {
   "id": 46,
   "text": "Miliki juga konsep neuroplasticity",
   "f0": 2795,
   "imp": false
  },
  {
   "id": 47,
   "text": "agar lo tidak ngasal dan salah langkah,",
   "f0": 2859,
   "imp": false
  },
  {
   "id": 48,
   "text": "dan bisa memulihkan kerusakan di otak akibat PMO.",
   "f0": 2921,
   "imp": false
  },
  {
   "id": 49,
   "text": "Miliki lewat link di bio,",
   "f0": 3007,
   "imp": true
  },
  {
   "id": 50,
   "text": "dijamin efektif buat lo sebagai pecandu berat PMO.",
   "f0": 3049,
   "imp": false
  },
  {
   "id": 51,
   "text": "(end card)",
   "f0": 3152,
   "imp": false
