[
{
"id": 1,
"sec": "HOOK",
"w0": 0,
"start": 0.0,
"w1": 3,
"text": "Jangan pernah menikah"
},
{
"id": 2,
"sec": "HOOK",
"w0": 3,
"start": 1.12,
"w1": 8,
"text": "dengan pria yang kecanduan PMO,"
},
{
"id": 3,
"sec": "ONESHOT",
"w0": 8,
"start": 3.22,
"w1": 13,
"text": "karena pria pengocok handal ini"
},
{
"id": 4,
"sec": "ONESHOT",
"w0": 13,
"start": 4.84,
"w1": 18,
"text": "mengalami tiga fase kerusakan otak"
},
{
"id": 5,
"sec": "ONESHOT",
"w0": 18,
"start": 6.92,
"w1": 24,
"text": "yang dia sendiri pun belum sadari."
},
{
"id": 6,
"sec": "F1",
"w0": 24,
"start": 8.82,
"w1": 26,
"text": "Fase pertama,"
},
{
"id": 7,
"sec": "F1",
"w0": 26,
"start": 9.66,
"w1": 32,
"text": "PMO ngebajak sistem reward di otaknya."
},
{
"id": 8,
"sec": "F1",
"w0": 32,
"start": 12.2,
"w1": 34,
"text": "Tiap malam"
},
{
"id": 9,
"sec": "F1",
"w0": 34,
"start": 12.74,
"w1": 39,
"text": "dopaminnya dibanjiri fantasi di layar,"
},
{
"id": 10,
"sec": "F1",
"w0": 39,
"start": 14.84,
"w1": 44,
"text": "sampai reseptornya tumpul dan kebal."
},
{
"id": 11,
"sec": "F1",
"w0": 44,
"start": 17.14,
"w1": 51,
"text": "Akibatnya, hal-hal nyata di hidupnya terasa hambar."
},
{
"id": 12,
"sec": "F1",
"w0": 51,
"start": 20.28,
"w1": 53,
"text": "Kerja males,"
},
{
"id": 13,
"sec": "F1",
"w0": 53,
"start": 21.28,
"w1": 55,
"text": "ibadah hampa,"
},
{
"id": 14,
"sec": "F1",
"w0": 55,
"start": 22.28,
"w1": 60,
"text": "bahkan perempuan nyata di depannya"
},
{
"id": 15,
"sec": "F1",
"w0": 60,
"start": 23.82,
"w1": 67,
"text": "kalah menarik dibanding ilusi wanita di layar."
},
{
"id": 16,
"sec": "F1",
"w0": 67,
"start": 26.14,
"w1": 74,
"text": "Otaknya udah gak kenal lagi rasa cukup,"
},
{
"id": 17,
"sec": "F1",
"w0": 74,
"start": 28.6,
"w1": 84,
"text": "karena PMO ngajarin dia buat selalu nyari yang lebih liar."
},
{
"id": 18,
"sec": "MID",
"w0": 84,
"start": 31.94,
"w1": 91,
"text": "Walaupun otak manusia punya kemampuan namanya neuroplasticity."
},
{
"id": 19,
"sec": "MID",
"w0": 91,
"start": 35.96,
"w1": 99,
"text": "Sirkuit yang rusak karena PMO bisa disambung ulang,"
},
{
"id": 20,
"sec": "MID",
"w0": 99,
"start": 38.74,
"w1": 108,
"text": "dan lo bisa dapetin konsepnya lewat link di bio."
},
{
"id": 21,
"sec": "MID",
"w0": 108,
"start": 41.18,
"w1": 120,
"text": "Tapi kalau pria sudah masuk ke fase kedua, ini jauh lebih bahaya."
},
{
"id": 22,
"sec": "F2",
"w0": 120,
"start": 45.28,
"w1": 123,
"text": "Di fase kedua,"
},
{
"id": 23,
"sec": "F2",
"w0": 123,
"start": 46.3,
"w1": 128,
"text": "PMO mulai menggerogoti prefrontal cortex,"
},
{
"id": 24,
"sec": "F2",
"w0": 128,
"start": 48.84,
"w1": 136,
"text": "pusat kendali yang bikin pria bisa berpikir terarah."
},
{
"id": 25,
"sec": "F2",
"w0": 136,
"start": 51.62,
"w1": 141,
"text": "Rem di otaknya makin blong,"
},
{
"id": 26,
"sec": "F2",
"w0": 141,
"start": 53.28,
"w1": 144,
"text": "tekadnya makin lemah,"
},
{
"id": 27,
"sec": "F2",
"w0": 144,
"start": 54.34,
"w1": 147,
"text": "dikit-dikit gampang tersulut,"
},
{
"id": 28,
"sec": "F2",
"w0": 147,
"start": 56.12,
"w1": 151,
"text": "ditegur sedikit langsung marah."
},
{
"id": 29,
"sec": "F2",
"w0": 151,
"start": 57.88,
"w1": 154,
"text": "Keputusan hidupnya asal-asalan,"
},
{
"id": 30,
"sec": "F2",
"w0": 154,
"start": 59.6,
"w1": 157,
"text": "gak punya arah,"
},
{
"id": 31,
"sec": "F2",
"w0": 157,
"start": 60.56,
"w1": 167,
"text": "dan yang paling bahaya, dia nganggep PMO itu bukan masalah."
},
{
"id": 32,
"sec": "RISET",
"w0": 167,
"start": 64.26,
"w1": 174,
"text": "Penelitian di jurnal JAMA Psychiatry tahun 2014"
},
{
"id": 33,
"sec": "RISET",
"w0": 174,
"start": 66.9,
"w1": 183,
"text": "nemuin bahwa makin banyak jam nonton bokep per minggu,"
},
{
"id": 34,
"sec": "RISET",
"w0": 183,
"start": 70.52,
"w1": 188,
"text": "maka makin kecil volume striatumnya."
},
{
"id": 35,
"sec": "RISET",
"w0": 188,
"start": 72.76,
"w1": 200,
"text": "Peneliti menduga ini yang bikin pecandu PMO butuh rangsangan yang makin liar"
},
{
"id": 36,
"sec": "RISET",
"w0": 200,
"start": 76.82,
"w1": 205,
"text": "buat ngerasain kepuasan yang sama."
},
{
"id": 37,
"sec": "F3",
"w0": 205,
"start": 78.78,
"w1": 208,
"text": "Di fase ketiga,"
},
{
"id": 38,
"sec": "F3",
"w0": 208,
"start": 79.78,
"w1": 217,
"text": "PMO udah ngerusak cara dia terhubung sama orang terdekatnya."
},
{
"id": 39,
"sec": "F3",
"w0": 217,
"start": 82.64,
"w1": 227,
"text": "Karena otaknya terbiasa sama perempuan di layar yang selalu nurut"
},
{
"id": 40,
"sec": "F3",
"w0": 227,
"start": 86.18,
"w1": 232,
"text": "dan bisa diganti tiap detik,"
},
{
"id": 41,
"sec": "F3",
"w0": 232,
"start": 87.88,
"w1": 239,
"text": "dia mulai mati rasa ke istrinya sendiri."
},
{
"id": 42,
"sec": "F3",
"w0": 239,
"start": 90.2,
"w1": 242,
"text": "Pelukan terasa biasa,"
},
{
"id": 43,
"sec": "F3",
"w0": 242,
"start": 91.6,
"w1": 245,
"text": "obrolan terasa ngebosenin,"
},
{
"id": 44,
"sec": "F3",
"w0": 245,
"start": 93.26,
"w1": 251,
"text": "dan kehadiran istrinya cuma dianggap rutinitas."
},
{
"id": 45,
"sec": "F3",
"w0": 251,
"start": 95.94,
"w1": 261,
"text": "Dari mati rasa, pelan-pelan dia mulai mandang istrinya sebagai objek,"
},
{
"id": 46,
"sec": "F3",
"w0": 261,
"start": 99.68,
"w1": 268,
"text": "bukan lagi sebagai manusia yang punya perasaan."
},
{
"id": 47,
"sec": "F3",
"w0": 268,
"start": 102.4,
"w1": 277,
"text": "Waktu istrinya gak bisa ngasih sensasi kayak di layar,"
},
{
"id": 48,
"sec": "F3",
"w0": 277,
"start": 105.28,
"w1": 280,
"text": "dia gampang kesel,"
},
{
"id": 49,
"sec": "F3",
"w0": 280,
"start": 106.42,
"w1": 283,
"text": "ngomongnya mulai kasar,"
},
{
"id": 50,
"sec": "F3",
"w0": 283,
"start": 107.88,
"w1": 299,
"text": "dan di ranjang dia bisa maksa adegan yang dia tonton tanpa peduli istrinya nyaman atau enggak."
},
{
"id": 51,
"sec": "F3",
"w0": 299,
"start": 112.94,
"w1": 307,
"text": "Lama-lama yang dulu cuma dingin berubah jadi abusive,"
},
{
"id": 52,
"sec": "F3",
"w0": 307,
"start": 116.26,
"w1": 310,
"text": "kasar di omongan"
},
{
"id": 53,
"sec": "F3",
"w0": 310,
"start": 117.34,
"w1": 316,
"text": "dan bisa juga kasar di perlakuan."
},
{
"id": 54,
"sec": "F3",
"w0": 316,
"start": 119.2,
"w1": 323,
"text": "Yang paling ngeri, dia nggak ngerasa salah,"
},
{
"id": 55,
"sec": "F3",
"w0": 323,
"start": 121.58,
"w1": 331,
"text": "karena PMO udah bikin dia lupa caranya berempati."
}
]